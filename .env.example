# Stratifit Digital Agency — Environment Variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (public — safe for browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://dmkxvalcflotfekpxdfw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (secret — server-only, never NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Communication Engine — AWS SES SMTP (secret — server-only) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Default sender address (must be verified in SES)
COMMUNICATION_FROM_EMAIL=
# Optional comma-separated "Reply as:" addresses for the dashboard
COMMUNICATION_REPLY_AS=
# Optional secret for the delivery webhook (sent as x-communication-secret)
COMMUNICATION_WEBHOOK_SECRET=

# --- AI provider (secret — server-only) ---
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
